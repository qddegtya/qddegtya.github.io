source "https://rubygems.org"

# Jekyll core
gem "jekyll", "~> 4.3"

# The "colorful" theme is vendored directly into this repository
# (forked from minimal-mistakes-jekyll 4.28.0), so no theme gem is required.
# The plugins below were previously pulled in transitively by that gem and
# must now be declared explicitly.
gem "jekyll-feed", "~> 0.17"
gem "jekyll-gist", "~> 1.5"
gem "jekyll-include-cache", "~> 0.2"
gem "jekyll-paginate-v2", "~> 3.0"
gem "jekyll-sitemap", "~> 1.4"

# Cross-platform timezone support (Windows / JRuby)
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem "wdm", "~> 0.1.1", platforms: [:mingw, :mswin, :x64_mingw]
